<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.domain.risenoveltoonback.repository.mapper.ToonNovelDataMapper">

<!-- 1. view_log 테이블에 유저가 있는지 확인-->
    <select id="existsContent" parameterType="map" resultType="boolean">
        SELECT CASE WHEN COUNT(*) &gt; 0 THEN TRUE ELSE FALSE END
        FROM view_log 
        WHERE user_id = #{userId} 
          AND content_id = #{contentId}
    </select>


<!-- 2. 유저가 없을 시 데이터 집어넣기 -->
    <insert id="updateView" parameterType="com.domain.risenoveltoonback.model.toonNovel.ToonNovelDto">
        INSERT into view_log (
            user_id,
            content_id,
            viewed_at
        ) VALUES (
            #{user_id},
            #{content_id},
            NOW()
        )
    </insert>

</mapper>