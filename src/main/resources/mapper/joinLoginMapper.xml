<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.domain.risenoveltoonback.repository.mapper.JoinLoginMapper">

<!-- 1. 회원가입 (INSERT) -->
    <insert id="joinUser">
        INSERT INTO users (
            user_id,
            password,
            nickname,
            cp_name,
            created_at
        ) VALUES (
            #{userId},
            #{password},
            #{nickname},
            #{cpName},
            NOW()
        )
    </insert>


<!-- 2. 회원 가입 아이디, 닉네임 중복 확인 -->
    <select id="joinduplicateCheck" parameterType="com.domain.risenoveltoonback.model.joinLogin.JoinFormDto" resultType="int">
        SELECT COUNT(*)
        FROM users
            WHERE user_id = #{userId} 
                or nickName = #{nickname}
    </select>

<!-- 3. 아이디, 닉네임 중복 확인-->
    <select id="duplicateCheck" parameterType="com.domain.risenoveltoonback.model.joinLogin.DuplicateCheckDto" resultType="int">
        SELECT COUNT(*)
        FROM users
    <choose>
        <when test="title == 'userId'">
            WHERE user_id = #{checkData}
        </when>
        <when test="title == 'nickname'">
            WHERE nickName = #{checkData}
        </when>
    </choose>
    </select>

<!-- 4. 로그인 -->
    <select id="loginUser" parameterType="string" resultType="int">
        SELECT COUNT(*)
            FROM users
            WHERE user_id = #{userId}
    </select>

<!-- 5. 유저 데이터 로컬 스토리지에 담을 것 -->
    <select id="userInfo" parameterType="string" resultType="com.domain.risenoveltoonback.model.joinLogin.UserInfoDto">
        SELECT  nickname, 
                current_balance as currentBalance,
                cp_name as cpName
            FROM users 
            WHERE user_id = #{userId}
    </select>

<!-- 6. 마이페이지 진입 시 [수정해야 함] -->
    <select id="myPageData" parameterType="string" resultType="com.domain.risenoveltoonback.model.joinLogin.MyPageDataDto">
        SELECT  nickname, 
                current_balance as currentBalance,
                cp_name as cpName
            FROM users 
            WHERE user_id = #{userId}
    </select>

<!-- 7. 정보 변경 [cpName, nickName] -->
    <update id="informationChange" parameterType="com.domain.risenoveltoonback.model.joinLogin.InformationChangeDto">
        UPDATE users
        <set>
            <if test="cpName != null and cpName != ''">
                cp_name = #{cpName},
            </if>
            <if test="nickname != null and nickname != ''">
                nickname = #{nickname}
            </if>
        </set>
        WHERE user_id = #{userId}
    </update>
</mapper>