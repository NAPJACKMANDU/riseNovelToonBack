<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.domain.risenoveltoonback.repository.mapper.JoinLoginMapper">

<!-- 1. 회원가입 (INSERT) -->
    <insert id="joinUser">
        INSERT INTO users (
            id,
            password,
            nickname,
            cp_name,
            created_at
        ) VALUES (
            #{id},
            #{password},
            #{nickname},
            #{cpName},
            NOW()
        )
    </insert>
</mapper>

